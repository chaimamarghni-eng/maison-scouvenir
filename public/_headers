/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: same-origin
  Content-Security-Policy: default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; script-src 'self'; worker-src 'self'; manifest-src 'self'; frame-ancestors 'none'

/sw.js
  Cache-Control: no-cache

/app.js
  Cache-Control: no-cache
